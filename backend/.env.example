# Copy to .env for local development. NEVER commit real secrets.
# In staging/production these come from AWS Secrets Manager / SSM.
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
MONGODB_URI=mongodb://localhost:27017/pesa?replicaSet=rs0
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=
HASH_PEPPER=
# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

DEFAULT_COUNTRY=KE
ENABLED_COUNTRIES=KE
# Development only: exposes GET /v1/auth/dev/outbox so you can read OTPs locally.
DEV_OTP_OUTBOX=true

# Payments: 'mock' is a signed sandbox provider and is refused in production.
PAYMENT_PROVIDERS=mock
DEFAULT_PAYMENT_PROVIDER=mock
MOCK_PROVIDER_WEBHOOK_SECRET=

# Safaricom Daraja (sandbox credentials from https://developer.safaricom.co.ke)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_TOKEN=
DARAJA_ALLOWED_IPS=

SMS_PROVIDER=console
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=ses (verified sender)
EMAIL_FROM=
SES_REGION=eu-west-1
FCM_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pesa-uploads

# Optional external AI narrative (only used with explicit user consent)
AI_EXTERNAL_PROVIDER=none
AI_API_KEY=

SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=
